# =====================================================================
# ESP32 Voice Assistant Configuration & API Keys
# =====================================================================

# 1. Groq Cloud API Key (100% Free, No Credit Card Required)
# Get your free key at: https://console.groq.com/keys
# Sign in with Google or GitHub -> Click 'Create API Key' -> Copy and paste below:
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# 2. Preferred default city for live weather queries (Optional)
DEFAULT_WEATHER_CITY=Delhi

# 3. Default operating mode on wake-word trigger (Optional)
# Options: 'ask' (prompts in terminal), 'assistant', 'moonshine', 'whisper'
DEFAULT_ASR_MODE=ask
